{
  "name": "@balanza/pi-codetour",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "A pi extension that guides you through a codebase by driving an editor in a terminal split.",
  "main": "index.ts",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balanza/pi-codetour.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test test/*.test.ts",
    "version:next": "node scripts/next-version.mjs",
    "release": "node scripts/next-version.mjs --apply"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
