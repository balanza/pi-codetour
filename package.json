{
  "name": "pi-codetour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A pi extension that guides you through a codebase by driving an editor in a terminal split.",
  "main": "index.ts",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": ["index.ts", "src", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
